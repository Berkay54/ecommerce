# Existing PostgreSQL connection (keep your current migrated database).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Generate a strong, persistent secret; never use these placeholder values.
AUTH_SECRET=YOUR_AUTH_SECRET
BLOB_READ_WRITE_TOKEN=YOUR_VERCEL_BLOB_TOKEN
# iyzico SANDBOX only. Never prefix credentials with NEXT_PUBLIC_.
IYZIPAY_API_KEY=YOUR_SANDBOX_API_KEY
IYZIPAY_SECRET_KEY=YOUR_SANDBOX_SECRET_KEY
IYZIPAY_URI=https://sandbox-api.iyzipay.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
